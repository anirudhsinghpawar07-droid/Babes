
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#fff4f7">
<title>For GupChup ♡</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --rose: #c96c88;
  --deep: #984660;
  --pink: #f8dce5;
  --lavender: #e9e0f8;
  --cream: #fffaf4;
  --ink: #563e4b;
  --muted: #8b7180;
  --shadow: 0 12px 35px rgba(125,70,95,.10);
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: "DM Sans", sans-serif;
  line-height: 1.75;
  overflow-x: hidden;
}

button, a { -webkit-tap-highlight-color: transparent; }
button { font: inherit; }
a { text-decoration: none; color: inherit; }

.script {
  font-family: "Dancing Script", cursive;
  font-weight: 600;
}

.section {
  padding: 88px 20px;
  scroll-margin-top: 75px;
}

.container {
  width: min(100%, 1000px);
  margin: auto;
}

.section-heading {
  text-align: center;
  margin-bottom: 42px;
}

.eyebrow {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--rose);
  font-weight: 700;
}

h2 {
  font-size: clamp(38px, 6vw, 58px);
  line-height: 1.2;
  margin: 10px 0;
}

.section-heading p {
  max-width: 560px;
  margin: 12px auto 0;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  border-radius: 50px;
  padding: 13px 23px;
  background: var(--deep);
  color: white;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(153,70,95,.18);
  transition: transform .25s, box-shadow .25s;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(153,70,95,.24);
}

/* Welcome */

.welcome-gate {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 22px;
  background:
    radial-gradient(ellipse at top left, #f8dce8, transparent 55%),
    radial-gradient(ellipse at bottom right, #e5dcf8, transparent 55%),
    var(--cream);
  transition: opacity .8s, visibility .8s;
}

.welcome-gate.hide {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.gate-card {
  width: min(100%, 470px);
  text-align: center;
  padding: 36px 24px;
  border-radius: 30px;
  background: rgba(255,255,255,.76);
  border: 1px solid white;
  box-shadow: var(--shadow);
  animation: float-card 4s ease-in-out infinite;
}

.gate-heart {
  font-size: 65px;
  animation: heartbeat 1.8s infinite;
}

.gate-card h1 {
  font-size: clamp(48px, 10vw, 70px);
  line-height: 1.1;
  color: var(--deep);
  margin: 8px 0 15px;
}

.gate-card p { color: var(--muted); }

.preview-message {
  display: none;
  animation: fade-up .7s ease both;
}

.preview-message.show { display: block; }

.preview-message h2 {
  color: var(--deep);
  font-size: 35px;
}

.gate-note {
  font-size: 12px;
  margin-top: 23px;
}

/* Website and navigation */

#site {
  opacity: 0;
  visibility: hidden;
  transition: opacity .8s;
}

#site.open {
  opacity: 1;
  visibility: visible;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255,250,244,.94);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid #f2e1e8;
}

.nav {
  width: min(100%, 1100px);
  margin: auto;
  min-height: 65px;
  padding: 10px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.brand {
  font-size: 29px;
  color: var(--deep);
  white-space: nowrap;
}

.nav-links {
  display: flex;
  gap: 18px;
  align-items: center;
  font-size: 12px;
  color: var(--muted);
}

.nav-links a:hover { color: var(--deep); }

/* Hero */

.hero {
  min-height: 77vh;
  display: grid;
  align-items: center;
  text-align: center;
  background:
    radial-gradient(ellipse at 15% 20%, #f9dfe9, transparent 42%),
    radial-gradient(ellipse at 85% 70%, #eae0fa, transparent 42%),
    var(--cream);
}

.hero .container { max-width: 780px; }

.hero-heart {
  font-size: 43px;
  margin-bottom: 10px;
}

.hero h1 {
  font-size: clamp(52px, 10vw, 89px);
  line-height: 1.12;
  color: var(--deep);
  margin: 15px 0 22px;
}

.hero p {
  max-width: 620px;
  margin: 0 auto 26px;
  font-size: 16px;
  color: var(--muted);
}

.signature {
  color: var(--rose);
  font-size: 31px;
  margin-top: 20px;
}

/* Story */

.story-section { background: white; }

.story-card {
  max-width: 760px;
  margin: auto;
  padding: clamp(25px, 5vw, 48px);
  border-radius: 25px;
  background: linear-gradient(135deg, #fff0f4, #fbf7ff);
  border: 1px solid #f1dfe7;
  box-shadow: var(--shadow);
  text-align: center;
}

.big-quote {
  font-family: "Dancing Script", cursive;
  font-size: 70px;
  line-height: 1;
  color: var(--rose);
}

/* Timeline with no dates */

.timeline {
  max-width: 720px;
  margin: auto;
  position: relative;
}

.timeline::before {
  content: "";
  position: absolute;
  top: 12px;
  bottom: 12px;
  left: 21px;
  width: 2px;
  background: linear-gradient(var(--rose), #c8b6ed);
}

.moment {
  position: relative;
  padding: 0 0 28px 61px;
}

.moment:last-child { padding-bottom: 0; }

.moment-dot {
  position: absolute;
  left: 11px;
  top: 7px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: white;
  border: 5px solid var(--rose);
  box-shadow: 0 0 0 5px #f9e4eb;
}

.moment-card {
  background: white;
  border: 1px solid #f0dfe6;
  border-radius: 19px;
  padding: 21px 24px;
  box-shadow: var(--shadow);
}

.moment-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--rose);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.moment h3 { margin: 5px 0; font-size: 20px; }

.moment p { margin: 0; color: var(--muted); font-size: 14px; }

/* Reasons cards */

.reasons-section {
  background: linear-gradient(150deg, #fff4f6, #f8f2ff);
}

.reason-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 15px;
}

.reason-card {
  display: block;
  width: 100%;
  min-height: 185px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  perspective: 1000px;
  color: var(--ink);
}

.reason-inner {
  display: block;
  position: relative;
  min-height: 185px;
  transform-style: preserve-3d;
  transition: transform .65s;
}

.reason-card.flipped .reason-inner { transform: rotateY(180deg); }

.reason-front, .reason-back {
  position: absolute;
  inset: 0;
  padding: 15px 11px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 19px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-shadow: var(--shadow);
}

.reason-front {
  background: rgba(255,255,255,.9);
  border: 1px solid #efdae4;
}

.reason-back {
  background: linear-gradient(145deg, #c87994, #98749f);
  color: white;
  transform: rotateY(180deg);
}

.reason-number {
  font: 600 29px "Dancing Script", cursive;
  color: var(--rose);
}

.reason-emoji { font-size: 27px; }

.reason-front small { color: var(--muted); font-size: 11px; }

.reason-back p { font-size: 12px; line-height: 1.6; margin: 0; }

/* Open when letters */

.letters-section { background: var(--cream); }

.letter-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-bottom: 27px;
}

.letter-btn {
  border: 1px solid #e9ccda;
  background: white;
  color: var(--deep);
  border-radius: 50px;
  padding: 12px 17px;
  cursor: pointer;
  transition: .25s;
}

.letter-btn:hover, .letter-btn.active {
  background: var(--deep);
  color: white;
  transform: translateY(-2px);
}

.letter-envelope {
  max-width: 650px;
  min-height: 205px;
  margin: auto;
  padding: 30px;
  border-radius: 23px;
  background: linear-gradient(135deg, white, #fff2f6);
  border: 1px solid #f0dce5;
  box-shadow: var(--shadow);
  text-align: center;
}

.letter-envelope h3 {
  font-size: 31px;
  margin: 5px 0 10px;
  color: var(--deep);
}

.letter-envelope p {
  color: var(--muted);
  margin: 0;
  white-space: pre-line;
}

/* Playful question */

.game-section {
  text-align: center;
  background: linear-gradient(150deg, #fbf3ff, #fff0f4);
}

.game-card {
  max-width: 700px;
  margin: auto;
  background: rgba(255,255,255,.88);
  border-radius: 28px;
  padding: clamp(25px, 5vw, 48px);
  border: 1px solid #efdfe9;
  box-shadow: var(--shadow);
}

.game-emoji { font-size: 53px; }

.game-card h2 { color: var(--deep); }

.playground {
  position: relative;
  height: 125px;
  max-width: 420px;
  margin: 15px auto 0;
}

.playground .btn {
  position: absolute;
  min-width: 115px;
}

#yesButton { top: 30px; left: 12%; }

#noButton {
  top: 30px;
  left: 58%;
  background: #eee5f4;
  color: #735b7d;
  box-shadow: none;
}

#gameAnswer {
  display: none;
  margin-top: 25px;
  animation: fade-up .7s ease both;
}

#gameAnswer.show { display: block; }

#gameAnswer h3 {
  font-size: 39px;
  color: var(--deep);
  margin: 0;
}

#gameAnswer p { color: var(--muted); }

/* Final letter */

.final-section {
  background:
    radial-gradient(ellipse at top left, #fae5ed, transparent 55%),
    radial-gradient(ellipse at bottom right, #e9e1fa, transparent 55%),
    var(--cream);
}

.final-paper {
  max-width: 790px;
  margin: auto;
  background: rgba(255,255,255,.9);
  padding: clamp(25px, 6vw, 62px);
  border-radius: 7px 24px 24px 7px;
  border-left: 5px solid #d79ab0;
  box-shadow: 0 15px 45px rgba(125,70,95,.11);
}

.final-paper h2 {
  font-size: clamp(36px, 6vw, 48px);
  color: var(--deep);
  text-align: center;
  margin-bottom: 26px;
}

.final-paper p { color: #705865; margin: 19px 0; }

.final-signature {
  text-align: right;
  margin-top: 35px;
  color: var(--deep);
  font-size: 36px;
}

.closing {
  text-align: center;
  padding-top: 38px;
  color: var(--muted);
  font-size: 13px;
}

.closing span { color: var(--rose); }

footer {
  background: white;
  text-align: center;
  padding: 23px 15px;
  color: var(--muted);
  font-size: 12px;
  border-top: 1px solid #f2e4e9;
}

/* Floating hearts */

#floatingLayer, #celebrationLayer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

#floatingLayer { z-index: 2; }
#celebrationLayer { z-index: 2000; }

.float-particle {
  position: absolute;
  bottom: -40px;
  opacity: 0;
  animation: float-up linear forwards;
  user-select: none;
}

.confetti-piece {
  position: absolute;
  top: -35px;
  animation: confetti-fall 3.4s ease-in forwards;
}

@keyframes float-up {
  0% { transform: translate3d(0,0,0) rotate(0deg); opacity: 0; }
  10% { opacity: .6; }
  85% { opacity: .35; }
  100% { transform: translate3d(var(--drift),-115vh,0) rotate(var(--spin)); opacity: 0; }
}

@keyframes confetti-fall {
  to { transform: translate3d(var(--drift),110vh,0) rotate(var(--spin)); opacity: 0; }
}

@keyframes heartbeat {
  0%,100% { transform: scale(1); }
  15% { transform: scale(1.13); }
  30% { transform: scale(1); }
  45% { transform: scale(1.09); }
}

@keyframes float-card {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Fade in while scrolling */

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity .75s ease, transform .75s ease;
}

.reveal.visible { opacity: 1; transform: translateY(0); }

@media (max-width: 800px) {
  .nav { flex-wrap: wrap; justify-content: center; }
  .brand { width: 100%; text-align: center; }
  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .reason-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
  .reason-card, .reason-inner { min-height: 170px; }
}

@media (max-width: 420px) {
  .section { padding: 70px 16px; }
  .letter-buttons { gap: 8px; }
  .letter-btn { padding: 10px 13px; font-size: 12px; }
  .playground .btn { min-width: 100px; padding: 12px 14px; }
  #yesButton { left: 7%; }
  #noButton { left: 57%; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
  .reveal { opacity: 1; transform: none; }
}
</style>
</head>

<body>

<div id="floatingLayer" aria-hidden="true"></div>
<div id="celebrationLayer" aria-hidden="true"></div>

<!-- FIRST SCREEN -->
<div class="welcome-gate" id="welcomeGate">
  <div class="gate-card">
    <div class="gate-heart">💗</div>
    <h1 class="script">A little world of us</h1>
    <p>I made a tiny something for my favourite girl.</p>

    <button class="btn" id="openSurprise">Tap to open ♡</button>

    <div class="preview-message" id="previewMessage">
      <h2 class="script">Hey, GupChup! 💌</h2>
      <p>I made something just for you...
A little place filled with love, a few silly surprises, and reminders of how special you are to me.</p>
      <button class="btn" id="enterSite">Come inside, love ♥</button>
    </div>

    <p class="gate-note">Just for you, from Your Babe ✨</p>
  </div>
</div>

<!-- MAIN PAGE -->
<div id="site">

  <header class="topbar">
    <nav class="nav">
      <a class="brand script" href="#welcome">you & me ♡</a>
      <div class="nav-links">
        <a href="#our-story">Our story</a>
        <a href="#timeline">Little moments</a>
        <a href="#reasons">Reasons</a>
        <a href="#letters">Open when...</a>
        <a href="#final-letter">My letter</a>
      </div>
    </nav>
  </header>

  <!-- WELCOME -->
  <section class="section hero" id="welcome">
    <div class="container reveal">
      <div class="hero-heart">🌷</div>
      <div class="eyebrow">A little corner of the internet</div>
      <h1 class="script">For you, GupChup</h1>
      <p>
        Out of all the things this big world has to offer,
        I wanted to make one little place that is just for you.
        No special occasion needed. Just because you're you,
        and because you make my world a little better. 💗
      </p>
      <a href="#our-story" class="btn">Let's begin our little story ↓</a>
      <div class="signature script">With love, Your Babe ♡</div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="section story-section" id="our-story">
    <div class="container">
      <div class="section-heading reveal">
        <div class="eyebrow">Chapter one</div>
        <h2 class="script">How it all feels</h2>
        <p>Some people slowly become your favourite part of the day.</p>
      </div>

      <div class="story-card reveal">
        <div class="big-quote">“</div>
        <p>
          Somewhere between the conversations, the laughs, the little
          moments and all the things we share, you became someone
          really special to me.
        </p>
        <p>
          Maybe our story doesn't need a dramatic beginning or a perfect
          movie scene. Maybe the best part is simply that we found each
          other, got to know each other, and keep creating our own little
          world along the way.
        </p>
        <p>
          And honestly? I'm pretty happy that I get to call you
          <strong>my GupChup.</strong> 🥹
        </p>
        <div class="signature script">Somehow, it's always you. ♡</div>
      </div>
    </div>
  </section>

  <!-- OUR LITTLE TIMELINE -->
  <section class="section" id="timeline">
    <div class="container">
      <div class="section-heading reveal">
        <div class="eyebrow">Little things that matter</div>
        <h2 class="script">Our little timeline</h2>
        <p>No dates to remember. Just the lovely little things that make a story special.</p>
      </div>

      <div class="timeline">

        <div class="moment reveal">
          <div class="moment-dot"></div>
          <div class="moment-card">
            <div class="moment-label">Chapter 01 · The beginning</div>
            <h3>Two people, one little story 🌸</h3>
            <p>Every lovely story starts somewhere. I'm just glad ours exists.</p>
          </div>
        </div>

        <div class="moment reveal">
          <div class="moment-dot"></div>
          <div class="moment-card">
            <div class="moment-label">Chapter 02 · Getting closer</div>
            <h3>Conversations that just happen 💌</h3>
            <p>When talking to someone stops feeling like an effort and starts feeling natural.</p>
          </div>
        </div>

        <div class="moment reveal">
          <div class="moment-dot"></div>
          <div class="moment-card">
            <div class="moment-label">Chapter 03 · The little things</div>
            <h3>Smiles for no particular reason 😊</h3>
            <p>Random thoughts, unexpected laughs, and the small moments that stay with us.</p>
          </div>
        </div>

        <div class="moment reveal">
          <div class="moment-dot"></div>
          <div class="moment-card">
            <div class="moment-label">Chapter 04 · Right now</div>
            <h3>Still choosing our story 💗</h3>
            <p>One day, one conversation, one memory at a time. There's more to discover together.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TEN REASONS -->
  <section class="section reasons-section" id="reasons">
    <div class="container">
      <div class="section-heading reveal">
        <div class="eyebrow">Ten tiny reminders</div>
        <h2 class="script">Reasons I love you</h2>
        <p>Tap a card to reveal a reason. Yes, there are ten. And yes, I could've made more. 😉</p>
      </div>
      <div class="reason-grid" id="reasonGrid"></div>
    </div>
  </section>

  <!-- OPEN WHEN LETTERS -->
  <section class="section letters-section" id="letters">
    <div class="container">
      <div class="section-heading reveal">
        <div class="eyebrow">A tiny hug whenever you need one</div>
        <h2 class="script">Open when...</h2>
        <p>Little messages from Your Babe, saved here for the days you need them.</p>
      </div>

      <div class="letter-buttons reveal">
        <button class="letter-btn active" data-letter="sad">🥺 When you're sad</button>
        <button class="letter-btn" data-letter="miss">💌 When you miss me</button>
        <button class="letter-btn" data-letter="sleep">🌙 When you can't sleep</button>
        <button class="letter-btn" data-letter="doubt">🌻 When you doubt yourself</button>
        <button class="letter-btn" data-letter="smile">😋 When you need a smile</button>
      </div>

      <div class="letter-envelope reveal" aria-live="polite">
        <div style="font-size:35px" id="letterEmoji">🫶</div>
        <h3 class="script" id="letterTitle">Hey, my favourite person...</h3>
        <p id="letterText">Take a breath, okay? You don't have to figure everything out all at once.
You're allowed to have difficult days and still be doing your best.
Be gentle with yourself today. I'm rooting for you, always. ❤️</p>
      </div>
    </div>
  </section>

  <!-- THE GAME -->
  <section class="section game-section" id="surprise">
    <div class="container">
      <div class="game-card reveal">
        <div class="game-emoji">🥹💗</div>
        <div class="eyebrow">One very important question</div>
        <h2 class="script">GupChup, will you always be my favourite person?</h2>
        <p>Think carefully, madam. One button is a little shy. 🙈</p>

        <div class="playground" id="playground">
          <button class="btn" id="yesButton">YES! 💖</button>
          <button class="btn" id="noButton">No 🙈</button>
        </div>

        <div id="gameAnswer" aria-live="polite">
          <h3 class="script">Yayyy, GupChup! 🥹❤️</h3>
          <p>
            Okay, I'm smiling at my screen now.
            Here's to more laughter, honest conversations, random silliness,
            and little moments that mean a lot.
            I hope we keep making each other smile for a long, long time.
          </p>
          <div class="signature script">Big hug from Your Babe ♡</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL LETTER -->
  <section class="section final-section" id="final-letter">
    <div class="container">
      <div class="section-heading reveal">
        <div class="eyebrow">One last thing</div>
        <h2 class="script">A letter for you</h2>
        <p>No jokes for a minute. Just something from my heart.</p>
      </div>

      <div class="final-paper reveal">
        <h2 class="script">To my GupChup,</h2>

        <p>
          I don't think there is one perfect way to explain what someone
          means to you. Sometimes a big paragraph feels too small, and
          sometimes a tiny message is enough to make an ordinary day
          feel special. So I thought I'd make you this little corner of
          the internet instead.
        </p>

        <p>
          GupChup, I hope you know that you don't have to do anything
          extraordinary to be special to me. You don't have to be happy
          all the time, have everything figured out, or pretend that
          every day is going perfectly. You get to be yourself around me.
          The happy you, the quiet you, the sleepy you, the overthinking
          you, and even the slightly dramatic you. Yes, that last one
          definitely deserves a special mention. 😂
        </p>

        <p>
          I love the idea of having someone with whom the simple things
          can be enough. A conversation that goes on longer than expected.
          A silly joke that makes absolutely no sense to anyone else.
          A small message that says, "Hey, I thought of you."
          These are the things that make a connection feel real to me.
        </p>

        <p>
          I also know that no relationship is made of perfect moments
          alone. There will be busy days, misunderstandings, different
          opinions, and times when one of us needs a little patience.
          When those moments come, I hope we remember to listen to each
          other, speak honestly, and try to understand before trying to
          win an argument. Being on the same team matters more than
          being right about every little thing.
        </p>

        <p>
          I want to see you grow, chase the things that matter to you,
          celebrate your wins, and keep becoming the person you want to
          be. I hope you always feel free to have your own dreams and
          your own little world, knowing that I can cheer you on while
          still being part of your life.
        </p>

        <p>
          And yes, I also reserve the right to annoy you with bad jokes,
          tease you for absolutely no reason, and occasionally remind
          you that you have a very cute boyfriend. These are important
          duties and I take them very seriously. 🤭
        </p>

        <p>
          But beneath all the teasing, I really do want you to feel
          cared for. Not only through a page like this, but through
          how I treat you, how I listen to you, how I respect you,
          and how I show up when it matters. Words are lovely, but
          the small actions behind them are what make them mean something.
        </p>

        <p>
          Thank you for being you, GupChup. Thank you for being someone
          I wanted to make something this silly and sweet for. I hope
          this page makes you smile today, and maybe makes you come back
          to it whenever you want a little reminder that someone is
          thinking about you.
        </p>

        <p>
          If there is one thing I want you to take away from all this,
          it is simple: you are special to me. I'm glad our paths crossed,
          and I hope we keep finding new reasons to laugh, learn, care
          for each other, and make our own little memories.
          No need to make every moment perfect. Let's just keep making
          them ours. ❤️
        </p>

        <div class="final-signature script">
          Forever yours,<br>
          Your Babe ♡
        </div>
      </div>

      <div class="closing reveal">
        Made with love, a few silly thoughts, and a lot of affection.
        <br>
        <span>End of this page. Not the end of our story. 💗</span>
      </div>
    </div>
  </section>

  <footer>
    A tiny website for GupChup, made by Your Babe ♡
  </footer>

</div>

<script>
/* WELCOME SCREEN */
const welcomeGate = document.getElementById("welcomeGate");
const previewMessage = document.getElementById("previewMessage");
const openSurprise = document.getElementById("openSurprise");
const enterSite = document.getElementById("enterSite");
const site = document.getElementById("site");

openSurprise.addEventListener("click", function () {
  previewMessage.classList.add("show");
  openSurprise.style.display = "none";
});

enterSite.addEventListener("click", function () {
  site.classList.add("open");
  welcomeGate.classList.add("hide");

  setTimeout(function () {
    welcomeGate.remove();
    document.getElementById("welcome").scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }, 750);
});

/* SCROLL FADE-IN */
const revealElements = document.querySelectorAll(".reveal");

if ("IntersectionObserver" in window) {
  const observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.10 });

  revealElements.forEach(function (element) {
    observer.observe(element);
  });
} else {
  revealElements.forEach(function (element) {
    element.classList.add("visible");
  });
}

/* TEN REASONS: AUTOMATICALLY CREATE THE CARDS */
const reasons = [
  ["🌷", "Your kindness, especially in the little things you do without expecting anything back."],
  ["😊", "The way you can make an ordinary day feel a little less ordinary."],
  ["🫶", "How I can be myself around you without needing to be perfect."],
  ["🌻", "Your little expressions and the way your face sometimes says it all."],
  ["💌", "Our conversations that somehow become one of the best parts of my day."],
  ["✨", "Your own way of seeing the world and making it interesting."],
  ["🤍", "That we can talk about serious things and be silly five minutes later."],
  ["🌙", "The small details you remember and the ways you show that you care."],
  ["🌸", "You remind me that love lives in everyday effort, not just grand gestures."],
  ["💗", "Because you're you. Ten reasons aren't enough, but they're a start."]
];

const reasonGrid = document.getElementById("reasonGrid");

reasons.forEach(function (reason, index) {
  const card = document.createElement("button");
  card.className = "reason-card reveal";
  card.setAttribute("aria-label", "Reveal reason " + (index + 1));
  card.setAttribute("aria-pressed", "false");

  card.innerHTML = `
    <span class="reason-inner">
      <span class="reason-front">
        <span class="reason-emoji">${reason[0]}</span>
        <span class="reason-number">${String(index + 1).padStart(2, "0")}</span>
        <small>Tap to reveal ♡</small>
      </span>
      <span class="reason-back">
        <span class="reason-emoji">♡</span>
        <p>${reason[1]}</p>
      </span>
    </span>
  `;

  card.addEventListener("click", function () {
    card.classList.toggle("flipped");
    card.setAttribute(
      "aria-pressed",
      card.classList.contains("flipped") ? "true" : "false"
    );
  });

  reasonGrid.appendChild(card);
});

/* FADE-IN FOR THE GENERATED CARDS */
reasonGrid.querySelectorAll(".reveal").forEach(function (element) {
  if ("IntersectionObserver" in window) {
    const cardObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          cardObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.10 });

    cardObserver.observe(element);
  } else {
    element.classList.add("visible");
  }
});

/* FLOATING HEARTS AND FLOWERS */
const floatingLayer = document.getElementById("floatingLayer");
const floatingSymbols = ["♡", "♥", "🌸", "💗", "✿", "💕"];

function addFloatingParticle() {
  if (document.hidden) return;

  const particle = document.createElement("span");
  particle.className = "float-particle";
  particle.textContent =
    floatingSymbols[Math.floor(Math.random() * floatingSymbols.length)];

  particle.style.left = Math.random() * 100 + "vw";
  particle.style.fontSize = (13 + Math.random() * 15) + "px";
  particle.style.setProperty("--drift", (Math.random() * 150 - 75) + "px");
  particle.style.setProperty("--spin", (Math.random() * 150 - 75) + "deg");
  particle.style.animationDuration = (9 + Math.random() * 9) + "s";

  floatingLayer.appendChild(particle);

  setTimeout(function () {
    particle.remove();
  }, 19000);
}

for (let i = 0; i < 10; i++) {
  setTimeout(addFloatingParticle, i * 500);
}

setInterval(addFloatingParticle, 1300);

/* OPEN-WHEN LETTERS */
const letterMessages = {
  sad: {
    emoji: "🫶",
    title: "Hey, my favourite person...",
    message: "Take a breath, okay? You don't have to solve everything all at once. You're allowed to have difficult days and still be doing your best. Be gentle with yourself today. I'm rooting for you, always. ❤️"
  },
  miss: {
    emoji: "💌",
    title: "A little hug from Your Babe",
    message: "I wish I could magically appear next to you for a moment, steal a smile, and give you a proper hug. Until then, imagine one from me: the long, comfortable kind that says you don't have to explain anything. I hope you feel a little closer to me after reading this. 💗"
  },
  sleep: {
    emoji: "🌙",
    title: "Put those thoughts down for a while",
    message: "You have done enough for today, GupChup. Tomorrow can wait until tomorrow. Relax your shoulders, take a slow breath, and let yourself rest. I hope your dreams are gentle and your sleep is peaceful. Goodnight, my girl. 🤍"
  },
  doubt: {
    emoji: "🌻",
    title: "Look at you, still trying",
    message: "Please don't measure your worth by one difficult day, one mistake, or somebody else's timeline. There is so much more to you than a bad moment. I hope you can see some of the goodness in yourself that I see in you. One step at a time, okay? ❤️"
  },
  smile: {
    emoji: "🌸",
    title: "Emergency smile delivery!",
    message: "Official reminder: you are cute, you are allowed to laugh at absolutely ridiculous things, and you should probably drink some water. Also, whoever gave you permission to be this distracting should have thought about my concentration. 😂💗 Now smile, GupChup!"
  }
};

document.querySelectorAll(".letter-btn").forEach(function (button) {
  button.addEventListener("click", function () {
    document.querySelectorAll(".letter-btn").forEach(function (item) {
      item.classList.remove("active");
    });

    button.classList.add("active");

    const letter = letterMessages[button.dataset.letter];

    document.getElementById("letterEmoji").textContent = letter.emoji;
    document.getElementById("letterTitle").textContent = letter.title;
    document.getElementById("letterText").textContent = letter.message;
  });
});

/* THE SHY NO BUTTON */
const playground = document.getElementById("playground");
const noButton = document.getElementById("noButton");
const yesButton = document.getElementById("yesButton");
const gameAnswer = document.getElementById("gameAnswer");

function moveNoButton() {
  const maxX = Math.max(0, playground.clientWidth - noButton.offsetWidth);
  const maxY = Math.max(0, playground.clientHeight - noButton.offsetHeight);

  const oldX = parseFloat(noButton.style.left) || noButton.offsetLeft;
  let newX = Math.random() * maxX;

  if (Math.abs(newX - oldX) < 80 && maxX > 100) {
    newX = (newX + maxX * 0.55) % maxX;
  }

  const newY = Math.random() * maxY;

  noButton.style.left = Math.max(0, Math.min(newX, maxX)) + "px";
  noButton.style.top = Math.max(0, Math.min(newY, maxY)) + "px";
}

noButton.addEventListener("pointerenter", moveNoButton);

noButton.addEventListener("click", function (event) {
  event.preventDefault();
  moveNoButton();
});

noButton.addEventListener("touchstart", function (event) {
  event.preventDefault();
  moveNoButton();
}, { passive: false });

/* YES: CONFETTI AND HEARTS */
yesButton.addEventListener("click", function () {
  gameAnswer.classList.add("show");
  yesButton.textContent = "ALWAYS! 💖";
  noButton.style.display = "none";

  const layer = document.getElementById("celebrationLayer");
  const symbols = ["💗", "💖", "💕", "🌸", "✨", "🎉", "♥"];

  for (let i = 0; i < 65; i++) {
    const piece = document.createElement("span");
    piece.className = "confetti-piece";
    piece.textContent = symbols[Math.floor(Math.random() * symbols.length)];

    piece.style.left = Math.random() * 100 + "vw";
    piece.style.fontSize = (15 + Math.random() * 20) + "px";
    piece.style.setProperty("--drift", (Math.random() * 260 - 130) + "px");
    piece.style.setProperty("--spin", (Math.random() * 900 - 450) + "deg");
    piece.style.animationDelay = Math.random() * 1.2 + "s";

    layer.appendChild(piece);

    setTimeout(function () {
      piece.remove();
    }, 5000);
  }
});
</script>

</body>
</html>
